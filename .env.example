# Public HTTPS URL Twilio can reach (ngrok tunnel during POC testing), no trailing slash.
# e.g. https://abcd1234.ngrok-free.app
PUBLIC_BASE_URL=

PORT=3000

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# Created by `npm run setup:app` once PUBLIC_BASE_URL is set — see README.
TWILIO_GEMINI_AGENT_APP_SID=

# Gemini Live (Google AI Studio API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-live-preview
